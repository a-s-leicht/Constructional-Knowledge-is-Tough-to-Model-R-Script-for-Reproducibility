tab_cnt_spk_altt_age <- table(data_spoken$alternant_type, data_spoken$age_range)
tab_cnt_spk_altt_sec <- table(data_spoken$alternant_type, data_spoken$socio_economic_category)
tab_cnt_spk_altt_edu <- table(data_spoken$alternant_type, data_spoken$education)
