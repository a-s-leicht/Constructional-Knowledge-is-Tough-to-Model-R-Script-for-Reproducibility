# ==============================================================================
# LINGUISTIC FACTORS
# ==============================================================================
# ------------------------------------------------------------------------------
# GLMER: LINGUISTIC FACTORS (LEXICAL ITEM + (MODE V.S. GENRE))
# ------------------------------------------------------------------------------
# Fit a mixed-effects logistic regression model
glmer_add_mn_altt_lex_mod <- glmer(
alternant_type ~ lexical_item + mode + (1 | text_id),
data = data_main,
family = binomial
)
# Display the model summary
summary(glmer_add_mn_altt_lex_mod, correlation = TRUE)
# Fit a refined mixed-effects logistic regression model
glmer_add_mn_altt_lex_gen <- glmer(
alternant_type ~ lexical_item + genre + (1 | text_id),
data = data_main,
family = binomial
)
# Check whether the random-effects structure is singular
isSingular(glmer_add_mn_altt_lex_gen)
# Check convergence robustness across different optimisers
allFit(glmer_add_mn_altt_lex_gen)
# Display the model summary
summary(glmer_add_mn_altt_lex_gen, correlation = TRUE)
# Compare AIC values between the mode and genre models
AIC(glmer_add_mn_altt_lex_mod, glmer_add_mn_altt_lex_gen)
# Perform likelihood ratio test to assess whether the substitution is justified
anova(glmer_add_mn_altt_lex_mod, glmer_add_mn_altt_lex_gen, test = "Chisq")
# ------------------------------------------------------------------------------
# GLMER: LINGUISTIC FACTORS (LEXICAL ITEM + GENRE)
# ------------------------------------------------------------------------------
# Display the model summary
summary(glmer_add_mn_altt_lex_gen, correlation = TRUE)
# Compute odds ratios for the fixed effects
exp(fixef(glmer_add_mn_altt_lex_gen))
# Compute confidence intervals
exp(confint(glmer_add_mn_altt_lex_gen, method = "Wald", parm = "beta_"))
# Compute estimated marginal means for genre and lexical item
emm_add_mn_altt_lex_gen <- emmeans(glmer_add_mn_altt_lex_gen, ~ genre + lexical_item, type = "response")
# Display the estimated marginal means
emm_add_mn_altt_lex_gen
# Compute pairwise comparisons between factor levels
pairs(emm_add_mn_altt_lex_gen)
# Convert estimated marginal means to a data frame for more flexible plotting
df_emm_add_mn_altt_lex_gen <- as.data.frame(emm_add_mn_altt_lex_gen)
# Order factor levels for plots
# lexical_item
df_emm_add_mn_altt_lex_gen$lexical_item <- factor(
df_emm_add_mn_altt_lex_gen$lexical_item,
levels = c("take", "difficult", "hard", "easy", "worth"),
ordered = FALSE
)
# Create a custom additive plot with confidence intervals
ggplot(df_emm_add_mn_altt_lex_gen, aes(x = genre, y = prob, colour = lexical_item, group = lexical_item)) +
geom_point(position = position_dodge(width = 0.3)) +
geom_line(position = position_dodge(width = 0.3)) +
geom_errorbar(
aes(ymin = asymp.LCL, ymax = asymp.UCL),
width = 0.2,
position = position_dodge(width = 0.3)
) +
labs(
title = "Predicted Probabilities of Raising by Genre and Lexical Item with Confidence Intervals (Additive Model)",
x = "Genre",
y = "Predicted Probability (Raising)",
colour = "Lexical Item"
) +
theme_grey() +
scale_colour_hue()
# ------------------------------------------------------------------------------
# CROSSTABULATION AND PROPORTIONS: MARGINAL TRENDS
# ------------------------------------------------------------------------------
# Create count tables
tab_cnt_spk_altt_isr <- table(data_spoken$alternant_type, data_spoken$inter_speaker_relationships)
# Display count tables
tab_cnt_spk_altt_isr
