tab_pct_spk_altt_edu <- round(tab_prop_spk_altt_edu * 100, 2)
# Display percentage tables
tab_pct_spk_altt_age
tab_pct_spk_altt_sec
tab_pct_spk_altt_edu
# Convert proportion tables to data frames for plotting
df_prop_spk_altt_age <- as.data.frame(tab_prop_spk_altt_age)
df_prop_spk_altt_sec <- as.data.frame(tab_prop_spk_altt_sec)
df_prop_spk_altt_edu <- as.data.frame(tab_prop_spk_altt_edu)
# Rename columns for clarity
colnames(df_prop_spk_altt_age) <- c("alternant_type", "age_range", "proportion")
colnames(df_prop_spk_altt_sec) <- c("alternant_type", "socio_economic_category", "proportion")
