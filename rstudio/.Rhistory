# ------------------------------------------------------------------------------
# SUMMARY: TOUGH-SUBJECT LENGTH (ALTERNANT TYPE + MODE)
# ------------------------------------------------------------------------------
# Calculate descriptive statistics (Min., Q1, Median, Mean, Q3, Max.)
aggregate(
tough_subject_length ~ alternant_type + mode,
data = data_restricted,
FUN = summary
)
# Create violin plot
ggplot(data_restricted, aes(x = alternant_type, y = tough_subject_length, fill = alternant_type)) +
geom_violin(trim = FALSE, alpha = 0.7) +
geom_boxplot(
width = 0.10,
outlier.shape = NA,
fill = "white",
colour = "black",
alpha = 0.9,
show.legend = FALSE
) +
geom_jitter(
aes(colour = alternant_type),
width = 0.3,
alpha = 0.3,
size = 1.0,
show.legend = FALSE
) +
facet_grid(. ~ mode) +
labs(
title = "Distribution of Tough-Subject Length by Main Alternant Type and Mode",
x = "Alternant Type",
y = "Tough-Subject Length",
fill = "Alternant Type"
) +
coord_cartesian(ylim = c(0, 15)) +
scale_y_continuous(
breaks = c(0:5, 10, 15)
) +
theme_grey() +
scale_fill_hue() +
scale_colour_hue()
# ------------------------------------------------------------------------------
# GLMER: LINGUISTIC FACTORS (TOUGH-SUBJECT LENGTH * TOUGH-SUBJECT FORM * MODE)
# ------------------------------------------------------------------------------
# Fit the model
glmer_add_rst_altt_tsl_tsf_mod <- glmer(
alternant_type ~ tough_subject_length * tough_subject_form * mode + (1 | text_id) + (1 | lexical_item),
data = data_restricted,
family = binomial
)
# Checking for multicollinearity
vif(glmer_add_rst_altt_tsl_tsf_mod)
# Calculate adjusted GVIF for the fixed effects
sqrt(vif(glmer_add_rst_altt_tsl_tsf_mod))
# Refit two models to compare
glmer_int_rst_altt_tsf_mod <- glmer(
alternant_type ~ tough_subject_form * mode + (1 | text_id) + (1 | lexical_item),
data = data_restricted,
family = binomial
)
glmer_int_rst_altt_tsl_mod <- glmer(
alternant_type ~ tough_subject_length * mode + (1 | text_id) + (1 | lexical_item),
data = data_restricted,
family = binomial
)
# Compare AIC values between the tough_subject_form and tough_subject_length models
AIC(glmer_int_rst_altt_tsf_mod, glmer_int_rst_altt_tsl_mod)
# Perform likelihood ratio test to assess whether the substitution is justified
anova(glmer_int_rst_altt_tsf_mod, glmer_int_rst_altt_tsl_mod, test = "Chisq")
# ------------------------------------------------------------------------------
# GLMER: LINGUISTIC FACTORS (TOUGH-SUBJECT LENGTH * MODE)
# ------------------------------------------------------------------------------
# Display the model summary
summary(glmer_int_rst_altt_tsl_mod, correlation = TRUE)
# Compute odds ratios
exp(fixef(glmer_int_rst_altt_tsl_mod))
# Compute confidence intervals
exp(confint(glmer_int_rst_altt_tsl_mod, method = "Wald", parm = "beta_"))
# Compute predicted probabilities across tough_subject_length and mode
pred_int_rst_altt_tsl_mod <- ggpredict(
glmer_int_rst_altt_tsl_mod,
terms = c("tough_subject_length [1:60]", "mode")
)
# Display predicted values
print(pred_int_rst_altt_tsl_mod, n = Inf)
# Convert predicted values to data frame
df_pred_int_rst_altt_tsl_mod <- as.data.frame(pred_int_rst_altt_tsl_mod)
df_pred_int_rst_altt_tsl_mod <- subset(
df_pred_int_rst_altt_tsl_mod,
x %in% c(1:5, seq(10, 60, 5))
)
# Create a plot of predicted probabilities with confidence intervals
ggplot(
df_pred_int_rst_altt_tsl_mod,
aes(
x = x,
y = predicted,
colour = group,
group = group
)
) +
geom_point(position = position_dodge(width = 0.25)) +
geom_line(position = position_dodge(width = 0.25)) +
geom_ribbon(
aes(ymin = conf.low, ymax = conf.high, fill = group),
alpha = 0.15,
colour = NA,
position = position_dodge(width = 0.25)
) +
labs(
title = "Predicted Probabilities of Raising by Tough-Subject Length and Mode",
x = "Tough-Subject Length",
y = "Predicted Probability (Raising)",
colour = "Mode",
fill = "Mode"
) +
coord_cartesian(xlim = c(0, 15)) +
scale_x_continuous(
breaks = c(0:5, 10, 15)
) +
theme_grey() +
scale_colour_hue() +
scale_fill_hue()
# ------------------------------------------------------------------------------
# GLMER: LINGUISTIC FACTORS (TOUGH-SUBJECT FORM)
# ------------------------------------------------------------------------------
# Fit the model
glmer_add_rst_altt_tsf <- glmer(
alternant_type ~ tough_subject_form + (1 | text_id) + (1 | lexical_item),
data = data_restricted,
family = binomial
)
# Display the model summary
summary(glmer_add_rst_altt_tsf, correlation = TRUE)
# Compute odds ratios
exp(fixef(glmer_add_rst_altt_tsf))
# Compute confidence intervals
exp(confint(glmer_add_rst_altt_tsf, method = "Wald", parm = "beta_"))
# Compute estimated marginal means for tough_subject_form
emm_add_rst_altt_tsf <- emmeans(
glmer_add_rst_altt_tsf,
~ tough_subject_form,
type = "response"
)
# Display the estimated marginal means
emm_add_rst_altt_tsf
# Compute pairwise comparisons between factor levels
pairs(emm_add_rst_altt_tsf)
