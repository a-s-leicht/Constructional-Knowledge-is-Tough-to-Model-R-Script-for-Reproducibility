tab_prop_spk_altt_isr <- prop.table(tab_cnt_spk_altt_isr, margin = 2)
# Display proportion tables
tab_prop_spk_altt_isr
# Convert proportions to percentages
tab_pct_spk_altt_isr <- round(tab_prop_spk_altt_isr * 100, 2)
# Display percentage tables
tab_pct_spk_altt_isr
# Convert proportion tables to data frames for plotting
df_prop_spk_altt_isr <- as.data.frame(tab_prop_spk_altt_isr)
# Rename columns for clarity
colnames(df_prop_spk_altt_isr) <- c("alternant_type", "inter_speaker_relationships", "proportion")
