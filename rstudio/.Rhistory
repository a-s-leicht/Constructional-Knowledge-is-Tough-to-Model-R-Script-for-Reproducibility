# Build count tables of token_validity by lexical_item
tab_cnt_cln_tkn_lex <- table(data_clean$token_validity,data_clean$lexical_item)
# Display the raw counts
tab_cnt_cln_tkn_lex
# Convert counts to proportions
tab_prop_cln_tkn_lex <- prop.table(tab_cnt_cln_tkn_lex, margin = 2)
# Display the proportions
tab_prop_cln_tkn_lex
# Convert proportions to percentages and round to two decimal places
tab_pct_cln_tkn_lex <- round(tab_prop_cln_tkn_lex * 100, 2)
# Display the percentage tables
tab_pct_cln_tkn_lex
# ------------------------------------------------------------------------------
# CROSSTABULATION AND PROPORTIONS: ALTERNANT TYPES
# ------------------------------------------------------------------------------
# Build count tables of alternant_type by lexical_item
tab_cnt_cln_altt_lex <- table(data_clean$alternant_type,data_clean$lexical_item)
# Display the raw counts
tab_cnt_cln_altt_lex
# Convert counts to proportions within combination
tab_prop_cln_altt_lex <- prop.table(tab_cnt_cln_altt_lex, margin = 2)
# Display the proportions
tab_prop_cln_altt_lex
# Convert proportions to percentages and round to two decimal places
tab_pct_cln_altt_lex <- round(tab_prop_cln_altt_lex * 100, 2)
# Display the percentage tables
tab_pct_cln_altt_lex
# ------------------------------------------------------------------------------
# RELATIVE FREQUENCIES (PER 1M) OF ALTERNANT TYPES BY SUBCORPUS AND LEXICAL ITEM
# ------------------------------------------------------------------------------
# Define the desired order of lexical items for the coefficients
data_clean$lexical_item <- factor(
data_clean$lexical_item,
levels = c("easy", "hard", "difficult", "worth", "take")
)
# Build a cross table of alternant_type counts by lexical_item and mode
tab_cnt_cln_altt_lex_mod <- table(data_clean$alternant_type, data_clean$lexical_item, data_clean$mode)
# Display the raw counts
tab_cnt_cln_altt_lex_mod
# Convert counts to proportions within each combination
tab_prop_cln_altt_lex_mod <- prop.table(tab_cnt_cln_altt_lex_mod, margin = c(2, 3))
# Display the proportions
tab_prop_cln_altt_lex_mod
# Convert proportions to percentages and round to two decimal places
tab_pct_cln_altt_lex_mod <- round(tab_prop_cln_altt_lex_mod * 100, 2)
# Display the percentage table
tab_pct_cln_altt_lex_mod
# Calculation of the relative frequencies (per 1M)
# Scaling coefficients
mult_rel_freq_spk  <- c(194.0504691, 279.5362947, 128.1109893, 129.9949745, 231.7301719)
mult_rel_freq_wrt <- c(228.6791665, 328.961116, 159.1117564, 153.9132128, 223.9573452)
# Copy to avoid modifying the original
tab_rel_freq <- tab_prop_cln_altt_lex_mod
# Order of the columns in each slice
col_cln_altt_lex_mod <- colnames(tab_prop_cln_altt_lex_mod)
# Multiplication for writing
tab_rel_freq[, col_cln_altt_lex_mod, "writing"] <-
sweep(tab_prop_cln_altt_lex_mod[, col_cln_altt_lex_mod, "writing"], 2, mult_rel_freq_wrt, `*`)
# Multiplication for speech
tab_rel_freq[, col_cln_altt_lex_mod, "speech"] <-
sweep(tab_prop_cln_altt_lex_mod[, col_cln_altt_lex_mod, "speech"], 2, mult_rel_freq_spk, `*`)
# Display the relative frequency table
tab_rel_freq
# Convert the 3-way relative frequency table to a data frame for plotting
df_rel_freq <- as.data.frame(tab_rel_freq)
# Rename columns for clarity
colnames(df_rel_freq) <- c("alternant_type", "lexical_item", "mode", "rel_freq")
# Heatmap: relative frequency of alternant type by lexical item, faceted by mode
ggplot(df_rel_freq, aes(x = lexical_item, y = alternant_type, fill = rel_freq)) +
geom_tile(color = "white") +
geom_text(aes(label = round(rel_freq, 2)), size = 3, color = "white") +
facet_grid(. ~ mode) +
labs(
title = "Relative Frequency (per million tokens) of Alternant Type by Lexical Item and Mode",
x = "Lexical Item",
y = "Alternant Type",
fill = "Rel. Freq. (per 1M)"
) +
theme_grey() +
scale_fill_gradient(trans = "sqrt")
# ==============================================================================
# EXTRA-LINGUISTIC FACTORS
# ==============================================================================
# ------------------------------------------------------------------------------
# GLMER: SOCIO-DEMOGRAPHIC FACTORS (FULL ADDITIVE MODEL)
# ------------------------------------------------------------------------------
# Fit a mixed-effects logistic regression model
glmer_add_spk_altt_sociodemographic <- glmer(
alternant_type ~ gender + age_range +
socio_economic_category + education + dialect_details +
(1 | text_id) + (1 | lexical_item),
data = data_spoken,
family = binomial
)
# Display the model summary
summary(glmer_add_spk_altt_sociodemographic, correlation = TRUE)
# Compute odds ratios
exp(fixef(glmer_add_spk_altt_sociodemographic))
# Compute confidence intervals
exp(confint(glmer_add_spk_altt_sociodemographic, method = "Wald", parm = "beta_"))
# ------------------------------------------------------------------------------
# MODEL REFINEMENT: BACKWARD STEPWISE SELECTION (LRT)
# ------------------------------------------------------------------------------
# Evaluate the contribution of each fixed effect in the full spoken model
drop1(glmer_add_spk_altt_sociodemographic, test = "Chisq")
# Refit the model without the weakest predictor (highest p-value in LRT)
glmer_add_spk_altt_sociodemographic_reduced <- update(glmer_add_spk_altt_sociodemographic, . ~ . - age_range)
# Evaluate the contribution of each fixed effect in the reduced model
drop1(glmer_add_spk_altt_sociodemographic_reduced, test = "Chisq")
# Refit the model without the weakest predictor (highest p-value in LRT)
glmer_add_spk_altt_sociodemographic_reduced <- update(glmer_add_spk_altt_sociodemographic_reduced, . ~ . - socio_economic_category)
# Evaluate the contribution of each fixed effect in the reduced model
drop1(glmer_add_spk_altt_sociodemographic_reduced, test = "Chisq")
# Refit the model without the weakest predictor (highest p-value in LRT)
glmer_add_spk_altt_sociodemographic_reduced <- update(glmer_add_spk_altt_sociodemographic_reduced, . ~ . - education)
# Evaluate the contribution of each fixed effect in the reduced model
drop1(glmer_add_spk_altt_sociodemographic_reduced, test = "Chisq")
# Compare AIC values between the full and reduced models
AIC(glmer_add_spk_altt_sociodemographic, glmer_add_spk_altt_sociodemographic_reduced)
# Perform likelihood ratio test to assess whether the removal is justified
anova(glmer_add_spk_altt_sociodemographic, glmer_add_spk_altt_sociodemographic_reduced, test = "Chisq")
# Display the model summary
summary(glmer_add_spk_altt_sociodemographic_reduced, correlation = TRUE)
# Compute odds ratios
exp(fixef(glmer_add_spk_altt_sociodemographic_reduced))
# Compute confidence intervals
exp(confint(glmer_add_spk_altt_sociodemographic_reduced, method = "Wald", parm = "beta_"))
# Compute estimated marginal means for gender and dialect_details
emm_add_spk_altt_sociodemographic_reduced <- emmeans(glmer_add_spk_altt_sociodemographic_reduced, ~ gender + dialect_details, type = "response")
# Display the estimated marginal means
emm_add_spk_altt_sociodemographic_reduced
# Compute pairwise comparisons between factor levels
pairs(emm_add_spk_altt_sociodemographic_reduced)
# ------------------------------------------------------------------------------
# CHECKING FOR COLLINEARITY: GENDER & DIALECT
# ------------------------------------------------------------------------------
# Cross-tabulation of gender and dialect_details (the best predictor after gender)
tab_cnt_spk_gnd_dia <- table(data_spoken$gender, data_spoken$dialect_details)
# Display count table
tab_cnt_spk_gnd_dia
# Convert counts to proportions within dialect_details (column-wise)
tab_prop_spk_gnd_dia <- prop.table(tab_cnt_spk_gnd_dia, margin = 2)
# Display proportion table
tab_prop_spk_gnd_dia
# Convert proportions to percentages and round
tab_pct_spk_gnd_dia <- round(tab_prop_spk_gnd_dia * 100, 2)
# Display percentage table
tab_pct_spk_gnd_dia
# Chi-square test of independence (Use simulated p-value if expected counts are small)
chisq.test(tab_cnt_spk_gnd_dia, simulate.p.value = TRUE)
# Measure association strength (Cramér's V)
cramerV(tab_cnt_spk_gnd_dia)
# ------------------------------------------------------------------------------
# GLMER: SOCIO-DEMOGRAPHIC FACTORS (GENDER * DIALECT)
# ------------------------------------------------------------------------------
# Fit a mixed-effects logistic regression model
glmer_int_spk_altt_gnd_dia <- glmer(
alternant_type ~ gender * dialect_details + (1 | text_id) + (1 | lexical_item),
data = data_spoken,
family = binomial
)
# Compute VIFs for the fixed effects
vif(glmer_int_spk_altt_gnd_dia)
# Display the model summary
summary(glmer_int_spk_altt_gnd_dia, correlation = TRUE)
# Compute odds ratios for the fixed effects
exp(fixef(glmer_int_spk_altt_gnd_dia))
# Compute confidence intervals
exp(confint(glmer_int_spk_altt_gnd_dia, method = "Wald", parm = "beta_"))
# Compute estimated marginal means for the interaction
emm_int_spk_altt_gnd_dia <- emmeans(glmer_int_spk_altt_gnd_dia, ~ gender * dialect_details, type = "response")
# Display the estimated marginal means
emm_int_spk_altt_gnd_dia
# Compute pairwise comparisons for the interaction
pairs(emm_int_spk_altt_gnd_dia)
# Compute pairwise comparisons of gender within each dialect_details
pairs(emmeans(glmer_int_spk_altt_gnd_dia, ~ gender | dialect_details, type = "response"))
# Compute pairwise comparisons of dialect_details within each gender
pairs(emmeans(glmer_int_spk_altt_gnd_dia, ~ dialect_details | gender, type = "response"))
# ------------------------------------------------------------------------------
# CROSSTABULATION AND PROPORTIONS: MARGINAL TRENDS
# ------------------------------------------------------------------------------
